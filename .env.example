# ===========================================
# Job Queue System - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values

# ===========================================
# Database Configuration (Required)
# ===========================================
DATABASE_URL=postgresql://user:password@localhost:5432/jobs

# ===========================================
# Redis Configuration
# ===========================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ===========================================
# API Server Configuration
# ===========================================
PORT=3000
API_PORT=3000
NODE_ENV=development

# Optional: API key for protected endpoints (pause/resume/delete)
# If not set, these endpoints are unprotected (development mode)
# API_KEY=your-secret-api-key-here

# ===========================================
# Worker Configuration
# ===========================================
# Number of concurrent jobs per worker
WORKER_CONCURRENCY=4

# Interval for sweeping delayed jobs (ms)
SWEEP_INTERVAL_MS=1000

# Graceful shutdown timeout (ms)
SHUTDOWN_TIMEOUT_MS=30000

# ===========================================
# Frontend Configuration
# ===========================================
VITE_API_URL=http://localhost:3000
VITE_WS_URL=http://localhost:3000

# ===========================================
# Monitoring (Optional)
# ===========================================
# Prometheus metrics are exposed at /metrics endpoint
# Grafana dashboard JSON is available at infra/grafana-dashboard.json
